{
  "name": "michi-todo",
  "version": "1.0.0",
  "description": "Google Drive同期対応の日本語ToDoアプリ（Web/PWA + Electron）",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:win": "electron-builder --win portable --x64",
    "build:web": "node scripts/build-web.cjs",
    "prebuild:win": "node scripts/prepare-desktop.cjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.0.12",
    "jsdom": "30.1.3"
  },
  "build": {
    "appId": "jp.local.michitodo",
    "productName": "Michi ToDo",
    "files": [
      "src/**/*",
      "package.json",
      "!**/.env",
      "!**/.env.*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "artifactName": "Michi-ToDo-${version}-Windows-x64.${ext}"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
